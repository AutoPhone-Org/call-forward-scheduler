<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 说明文案 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/cloud_desc"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- PAT 输入框（敏感信息，password 输入类型） -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cloudPatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cloud_pat_hint"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gist ID 输入框 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cloudGistInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cloud_gist_hint"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 上传到云端 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cloudUploadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cloud_upload_btn"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cloud_sync"
            app:iconTint="@android:color/white" />

        <!-- 从云端恢复 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cloudDownloadButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cloud_download_btn"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cloud_download"
            app:iconTint="@color/brand_blue" />

        <!-- 状态提示 -->
        <TextView
            android:id="@+id/cloudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
